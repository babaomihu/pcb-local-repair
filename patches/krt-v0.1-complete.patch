diff --git a/py_router/netclass_resolver.py b/py_router/netclass_resolver.py
new file mode 100644
index 0000000..2403bf0
--- /dev/null
+++ b/py_router/netclass_resolver.py
@@ -0,0 +1,117 @@
+"""Shared KiCad 10 net-class pattern and per-property aggregation semantics.
+
+KiCad CTX_NETCLASS uses anchored regex OR anchored * / ? wildcards. It is
+not shell fnmatch: square brackets are literal in the wildcard branch.
+All explicit and pattern memberships participate; lowest numeric priority,
+then alphabetical name, wins each defined property. Default fills holes.
+
+The regex subset here uses Python's engine. POSIX-specific classes, word
+boundaries, extensions and formatted/group buses are rejected explicitly,
+not silently treated as a nonmatch. Native preflight remains authoritative.
+"""
+from functools import lru_cache
+import math
+import re
+
+DEFAULT_PRIORITY = 2147483647
+
+
+class UnsupportedNetclassPattern(ValueError):
+    pass
+
+
+def project_priorities(net_settings):
+    """KiCad's schema 3 -> 4 migration replaces priorities in file order."""
+    meta = net_settings.get('meta') or {}
+    version = meta.get('version')
+    migrate = isinstance(version, int) and not isinstance(version, bool) and version <= 3
+    result, ordinal = {}, 0
+    for entry in net_settings.get('classes') or []:
+        name = entry.get('name', 'Default')
+        fallback = DEFAULT_PRIORITY if name == 'Default' else ordinal
+        result[name] = fallback if migrate else int(entry.get('priority', fallback))
+        if name != 'Default':
+            ordinal += 1
+    return result
+
+
+@lru_cache(maxsize=1024)
+def expanded_patterns(pattern):
+    if not isinstance(pattern, str):
+        raise UnsupportedNetclassPattern('netclass pattern must be a string')
+    # Plain vector buses have an exact bounded expansion. Formatted vectors
+    # and group buses use KiCad's more extensive net-name parser.
+    vector = re.fullmatch(r'([^{}\[\]\s]+)\[(\d+)\.\.(\d+)\]', pattern)
+    if vector:
+        prefix, first, last = vector.groups()
+        first, last = sorted((int(first), int(last)))
+        if last - first > 4095:
+            raise UnsupportedNetclassPattern('netclass bus range exceeds 4096 members')
+        return tuple(prefix + str(i) for i in range(first, last + 1))
+    if re.search(r'\[\d+\.\.\d+\]', pattern) or re.search(r'\{[^{}]*\s[^{}]*\}', pattern):
+        raise UnsupportedNetclassPattern(f'formatted/group bus pattern is unsupported: {pattern!r}')
+    if (any(token in pattern for token in ('[[:', '[[.', '[[=', '(?'))
+            or re.search(r'\\[bBmMyY]', pattern) or '\n' in pattern or '\r' in pattern):
+        raise UnsupportedNetclassPattern(f'POSIX-specific/extended netclass regex is unsupported: {pattern!r}')
+    return (pattern,)
+
+
+@lru_cache(maxsize=4096)
+def _compiled(pattern):
+    expression = pattern
+    if not expression.startswith('^'):
+        expression = '^' + expression
+    if not expression.endswith('$'):
+        expression += '$'
+    try:
+        regular = re.compile(expression)
+    except re.error:
+        regular = None  # A valid wildcard can be an invalid regular expression.
+    wildcard = re.compile('^' + ''.join('.' if c == '?' else '.*' if c == '*'
+                                       else re.escape(c) for c in pattern) + '$')
+    return regular, wildcard
+
+
+def pattern_matches(name, pattern):
+    for expanded in expanded_patterns(pattern):
+        regular, wildcard = _compiled(expanded)
+        # KiCad appends ^/$ without grouping alternation, then requires a
+        # match at offset zero. Preserve that behavior rather than fullmatch.
+        if (regular is not None and regular.match(name)) or wildcard.match(name):
+            return True
+    return False
+
+
+def resolve_memberships(names, assignments, patterns):
+    # Validate even patterns that happen not to match this task's target.
+    for pattern, _ in patterns:
+        expanded_patterns(pattern)
+    result = {}
+    for nid, name in names.items():
+        if not name:
+            continue
+        assigned = assignments.get(name, ())
+        members = set([assigned] if isinstance(assigned, str) else assigned)
+        for pattern, classname in patterns:
+            if pattern_matches(name, pattern):
+                members.add(classname)
+        if members:
+            result[nid] = frozenset(members)
+    return result
+
+
+def ordered_members(classes, members):
+    def priority(name):
+        default = DEFAULT_PRIORITY if name == 'Default' else DEFAULT_PRIORITY - 1
+        return classes.get(name, {}).get('priority', default), name
+    return sorted(members, key=priority)
+
+
+def class_property(classes, members, prop):
+    for name in ordered_members(classes, members) + ['Default']:
+        value = classes.get(name, {}).get(prop)
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            if not math.isfinite(value) or value < 0:
+                raise ValueError(f'invalid netclass {name!r} {prop}: {value!r}')
+            return float(value)  # Zero is explicitly set, not an absent property.
+    return None
