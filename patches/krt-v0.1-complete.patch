+#!/usr/bin/env python3
+"""Small project fixtures for native-checked net-class matching and merging.
+
+No boards are downloaded or routed. The fixture writer is also used by the
+external native parity probe; expectations were checked on pcbnew 10.0.4.
+"""
+import json
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'py_router'))
+
+DEFAULT = {'name': 'Default', 'priority': 2147483647, 'clearance': .2,
+           'track_width': .2, 'via_diameter': .6, 'via_drill': .3,
+           'diff_pair_width': .2, 'diff_pair_gap': .25,
+           'diff_pair_via_gap': .25, 'microvia_diameter': .3,
+           'microvia_drill': .1, 'wire_width': 6, 'bus_width': 12,
+           'line_style': 0, 'pcb_color': 'rgba(0, 0, 0, 0.000)',
+           'schematic_color': 'rgba(0, 0, 0, 0.000)'}
+EXPECTED = {
+    'regex_out2': (.31, .17),
+    'glob.7': (.32, .18),
+    'literal[2]': (.34, .19),
+    'literal2': (.34, .19),
+    'prio7': (.33, .18),
+    'merge7': (.45, .21),
+    'tie7': (.19, .16),
+    'explicit_pattern7': (.33, .18),
+    'unassigned': (.2, .2),
+    'unknown': (.2, .2),
+    'zero': (.23, 0),
+    '[broken7': (.32, .18),
+    'prefix_extra': (.31, .17),
+    'DATA0': (.31, .17),
+    'DATA2': (.31, .17),
+    'DATA3': (.2, .2),
+}
+
+
+def fixture_project():
+    classes = [DEFAULT,
+               {'name': 'Regex', 'priority': 10, 'track_width': .31, 'clearance': .17},
+               {'name': 'Glob', 'priority': 10, 'track_width': .32, 'clearance': .18},
+               {'name': 'Brackets', 'priority': 10, 'track_width': .34, 'clearance': .19},
+               {'name': 'Low', 'priority': 20, 'track_width': .4, 'clearance': .4},
+               {'name': 'High', 'priority': 1, 'track_width': .33, 'clearance': .18},
+               {'name': 'WidthOnly', 'priority': 0, 'track_width': .45},
+               {'name': 'ClearanceOnly', 'priority': 5, 'clearance': .21},
+               {'name': 'Zulu', 'priority': 3, 'track_width': .7, 'clearance': .7},
+               {'name': 'Alpha', 'priority': 3, 'track_width': .19, 'clearance': .16},
+               {'name': 'Zero', 'priority': 0, 'track_width': .23, 'clearance': 0}]
+    patterns = [(r'regex_out\d+', 'Regex'), ('glob.?', 'Glob'),
+                ('literal[2]', 'Brackets'), ('prio.*', 'Low'),
+                (r'prio\d+', 'High'), ('merge*', 'ClearanceOnly'),
+                ('explicit_pattern*', 'High'), ('[broken*', 'Glob'),
+                ('prefix|other', 'Regex'), ('DATA[0..2]', 'Regex')]
+    return {'meta': {'filename': 'board.kicad_pro', 'version': 1},
+            'board': {'design_settings': {'rules': {'min_clearance': 0,
+                                                    'min_track_width': .1}}},
+            'net_settings': {'meta': {'version': 4}, 'classes': classes,
+                             'netclass_assignments': {'merge7': ['WidthOnly'],
+                                                      'tie7': ['Zulu', 'Alpha'],
+                                                      'explicit_pattern7': ['Low'],
+                                                      'unknown': ['Ghost'],
+                                                      'zero': ['Zero']},
+                             'netclass_patterns': [{'pattern': p, 'netclass': c}
+                                                   for p, c in patterns]}}
+
+
+def write_fixture(directory, project=None):
+    directory = Path(directory)
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / 'board.kicad_pcb'
+    nets = '\n'.join(f'(net {i} {json.dumps(n)})' for i, n in enumerate(EXPECTED, 1))
+    path.write_text('''(kicad_pcb (version 20240108) (generator "netclass_probe")
+      (general (thickness 1.6)) (paper "A4")
+      (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user))
+      (setup (pad_to_mask_clearance 0)) (net 0 "")
+      ''' + nets + '''
+      (gr_rect (start 0 0) (end 20 20) (stroke (width 0.1) (type default))
+               (fill none) (layer "Edge.Cuts")))\n''')
+    path.with_suffix('.kicad_pro').write_text(json.dumps(project or fixture_project(), indent=2) + '\n')
+    return path
+
+
+class NetclassResolution(unittest.TestCase):
+    def test_schema3_migration_replaces_stored_priorities(self):
+        from design_rules import DesignRules
+        from list_nets import read_design_rules, net_track_width_map_by_id, net_clearance_map_by_id
+        project = fixture_project()
+        project['net_settings']['meta']['version'] = 3
+        project['net_settings']['netclass_assignments'] = {
+            name: values[-1] for name, values in project['net_settings']['netclass_assignments'].items()}
+        with tempfile.TemporaryDirectory() as tmp:
+            board = write_fixture(tmp, project)
+            names = {1: 'prio7', 2: 'explicit_pattern7'}
+            pcb = SimpleNamespace(nets={i: SimpleNamespace(name=n) for i, n in names.items()},
+                                  groups={}, board_info=SimpleNamespace(copper_layers=[]))
+            rules = DesignRules.from_project(pcb, str(board))
+            read = read_design_rules(str(board))
+            widths = net_track_width_map_by_id(str(board), names, read)
+            clearances = net_clearance_map_by_id(str(board), names, read)
+            for nid in names:
+                with self.subTest(net=names[nid]):
+                    # Native 10.0.4 rebuilds priorities in file order during
+                    # schema 3 -> 4 migration: Low precedes High here.
+                    self.assertEqual(rules.class_value(nid, 'track_width'), .4)
+                    self.assertEqual(rules.class_value(nid, 'clearance'), .4)
+                    self.assertEqual(widths[nid], .4)
+                    self.assertEqual(clearances[nid], .4)
+
+    def test_consumers_agree_on_native_checked_properties(self):
+        from design_rules import DesignRules
+        from list_nets import (read_design_rules, net_class_memberships,
+                               net_track_width_map_by_id, net_clearance_map_by_id,
+                               net_clearance_map)
+        with tempfile.TemporaryDirectory() as tmp:
+            board = write_fixture(tmp)
+            names = dict(enumerate(EXPECTED, 1))
+            pcb = SimpleNamespace(nets={i: SimpleNamespace(name=n) for i, n in names.items()},
+                                  groups={}, board_info=SimpleNamespace(copper_layers=['F.Cu', 'B.Cu']))
+            rules = DesignRules.from_project(pcb, str(board))
+            read = read_design_rules(str(board))
+            widths = net_track_width_map_by_id(str(board), names, read)
+            clrs = net_clearance_map_by_id(str(board), names, read)
+            by_name = net_clearance_map(str(board), names.values(), read)
+            members = net_class_memberships(str(board), names, read)
+            for nid, name in names.items():
+                with self.subTest(net=name):
+                    width, clearance = EXPECTED[name]
+                    self.assertEqual(rules.class_value(nid, 'track_width'), width)
+                    self.assertEqual(rules.class_value(nid, 'clearance'), clearance)
+                    self.assertEqual(widths.get(nid, .2), width)
+                    self.assertEqual(clrs.get(nid, .2), clearance)
+                    self.assertEqual(by_name[name], clearance)
+                    self.assertEqual(set(rules.memberships.get(nid, ())), members.get(nid, set()))
+            unknown = next(nid for nid, name in names.items() if name == 'unknown')
+            self.assertIn('Ghost', rules.memberships[unknown])
+
+    def test_unsupported_patterns_are_explicit_errors(self):
+        from netclass_resolver import resolve_memberships, UnsupportedNetclassPattern
+        for pattern in ('[[:digit:]]+', r'\mNET\M', '(?i)NET', 'BUS{A B}', '~{D[0..2]}'):
+            with self.subTest(pattern=pattern):
+                with self.assertRaises(UnsupportedNetclassPattern):
+                    resolve_memberships({1: 'not-a-match'}, {}, [(pattern, 'Signal')])
+
+    def test_vector_expansion_is_bounded(self):
+        from netclass_resolver import expanded_patterns, UnsupportedNetclassPattern
+        self.assertEqual(expanded_patterns('DATA[2..0]'), ('DATA0', 'DATA1', 'DATA2'))
+        with self.assertRaises(UnsupportedNetclassPattern):
+            expanded_patterns('DATA[0..5000]')
+
+
+if __name__ == '__main__':
+    unittest.main()
