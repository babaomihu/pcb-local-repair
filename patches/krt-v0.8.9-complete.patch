+#!/usr/bin/env python3
+"""Exercise the real CLI selector via tiny temporary-board undo operations.
+
+No path search, native DRC, downloaded fixtures, or user board writes. Undo
+makes the selected scope observable: only that net's synthetic segment goes.
+"""
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+ROUTE = ROOT / 'py_router' / 'route.py'
+NAMES = ('DATA[0]', 'DATA0', 'DATA', '/Sheet/DATA', 'STAR*', 'STAR1',
+         'ASK?', 'ASKx', '!RESET', ' PAD ', 'GND')
+
+
+def make_board(directory):
+    board = directory / 'input.kicad_pcb'
+    rows = ['(kicad_pcb (version 20240108) (generator "literal_net_test")',
+            '(general (thickness 1.6)) (paper "A4")',
+            '(layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user))',
+            '(setup (pad_to_mask_clearance 0)) (net 0 "")']
+    for index, name in enumerate(NAMES, 1):
+        rows.append(f'(net {index} {json.dumps(name)})')
+        locked = ' (locked yes)' if name == 'GND' else ''
+        rows.append(f'(segment (start 2 {index}) (end 3 {index}) (width 0.2) '
+                    f'(layer "F.Cu") (net {index}) (uuid "{uuid.UUID(int=index)}"){locked})')
+    rows.append('(gr_rect (start 0 0) (end 20 20) (stroke (width 0.1) '
+                '(type default)) (fill none) (layer "Edge.Cuts")))')
+    board.write_text('\n'.join(rows)+'\n')
+    board.with_suffix('.kicad_pro').write_text(json.dumps({
+        'net_settings': {'meta': {'version': 4}, 'classes': [
+            {'name': 'Default', 'priority': 2147483647, 'track_width': .2,
+             'clearance': .2, 'via_diameter': .6, 'via_drill': .3}]}})+'\n')
+    return board
+
+
+def removed_names(before, after):
+    def track_ids(text):
+        return set(re.findall(r'\(uuid "([0-9a-f-]+)"\)', text))
+    removed = track_ids(before) - track_ids(after)
+    return {name for i, name in enumerate(NAMES, 1) if str(uuid.UUID(int=i)) in removed}
+
+
+class LiteralNetsCli(unittest.TestCase):
+    def run_cli(self, names, literal=True):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        directory = Path(temporary.name)
+        board = make_board(directory)
+        original = board.read_text()
+        project_original = board.with_suffix('.kicad_pro').read_bytes()
+        output = directory / 'output.kicad_pcb'
+        command = [sys.executable, '-B', str(ROUTE), str(board), str(output),
+                   '--undo', '--no-fix-drc-settings', '--strict-sizes']
+        if literal:
+            command.append('--literal-nets')
+        if names is not None:
+            command.extend(['--nets', *names])
+        completed = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=15)
+        self.assertEqual(board.read_text(), original)
+        self.assertEqual(board.with_suffix('.kicad_pro').read_bytes(), project_original)
+        return completed, original, output
+
+    def test_full_literal_names_select_only_the_named_net(self):
+        for name in ('DATA[0]', 'DATA', '/Sheet/DATA', 'STAR*', 'ASK?', '!RESET', ' PAD '):
+            with self.subTest(name=name):
+                result, original, output = self.run_cli([name])
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                self.assertEqual(removed_names(original, output.read_text()), {name})
+
+    def test_unknown_names_abort_even_with_a_known_name(self):
+        for names in (['DATA', 'UNKNOWN'], ['NO*'], ['!UNKNOWN'], ['']):
+            with self.subTest(names=names):
+                result, _, output = self.run_cli(names)
+                self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
+                self.assertIn('--literal-nets names do not exist', result.stderr)
+                self.assertFalse(output.exists())
+
+    def test_literal_mode_requires_explicit_names(self):
+        result, _, output = self.run_cli(None)
+        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
+        self.assertIn('--literal-nets requires explicit net names', result.stderr)
+        self.assertFalse(output.exists())
+
+    def test_default_wildcard_and_leaf_matching_remain(self):
+        for pattern, expected in [('DATA[0]', {'DATA0'}),
+                                  ('DATA', {'DATA', '/Sheet/DATA'}),
+                                  ('STAR*', {'STAR*', 'STAR1'}),
+                                  ('ASK?', {'ASK?', 'ASKx'})]:
+            with self.subTest(pattern=pattern):
+                result, original, output = self.run_cli([pattern], literal=False)
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                self.assertEqual(removed_names(original, output.read_text()), expected)
+
+    def test_literal_selection_keeps_locked_copper_protection(self):
+        result, original, output = self.run_cli(['GND'])
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(removed_names(original, output.read_text()), set())
+        self.assertIn('KiCad-locked', result.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
